# AI Chat Platform Environment Variables
# Copy this file to .env and update the values

# Required: OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here

# Database Configuration (optional - defaults provided)
POSTGRES_DB=ai_chat_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# JWT Configuration (optional - defaults provided)
JWT_SECRET=dev-docker-secret-key-for-development-only

# CORS Configuration (optional - defaults provided)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# Logging Configuration (optional)
LOG_LEVEL=DEBUG

# Application Configuration (optional)
SERVER_PORT=8080
THREAD_TIMEOUT_MINUTES=30

# Production Only (set these for production deployment)
# REQUIRE_SSL=true
# FLYWAY_CLEAN_DISABLED=true
# PROMETHEUS_ENABLED=true